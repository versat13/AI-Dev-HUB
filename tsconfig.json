{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "resolveJsonModule": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["Extension/ScrapAI/src/*"]
    }
  },
  "include": ["src/**/*", "Extension/ScrapAI/src/**/*"]
}
